# Ambassador Shopping Center — environment variables
# Copy to .env for local dev (server/server.js reads process.env directly;
# use `node -r dotenv/config server/server.js` or export these in your shell).
# On Render, set these in the dashboard — render.yaml already wires most of them.

# ── Core ──
PORT=3000
NODE_ENV=development
JWT_SECRET=                # long random string; sessions reset on restart if unset
ADMIN_KEY=                 # required to use /admin.html and any /api/admin/* route

# ── Database (omit both to run on a local JSON file at DATA_FILE, dev only) ──
DATABASE_URL=
DATA_FILE=./data.json

# ── Buyer sign-in (optional — omit to fall back to demo/guest auth) ──
GOOGLE_CLIENT_ID=
ALLOW_DEMO=1                # allow demo/guest sign-in even when GOOGLE_CLIENT_ID is set

# ── Buyer SMS (optional — omit for log-only mode, safe for local dev) ──
SMS_PROVIDER=               # afromessage | twilio
AFROMESSAGE_TOKEN=
AFROMESSAGE_FROM=
AFROMESSAGE_SENDER=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ── New-order alerts to a Telegram chat (optional) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
