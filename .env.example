# Ambassador Shopping Center — environment variables
# Copy to .env for local dev (server/server.js reads process.env directly;
# use `node -r dotenv/config server/server.js` or export these in your shell).
# On Render, set these in the dashboard — render.yaml already wires most of them.

# ── Core ──
PORT=3000
NODE_ENV=development
JWT_SECRET=                # long random string; sessions reset on restart if unset
ADMIN_KEY=                 # required to use /admin.html and any /api/admin/* route

# ── Database (omit both to run on a local JSON file at DATA_FILE, dev only) ──
DATABASE_URL=
DATA_FILE=./data.json

# ── Buyer sign-in (optional — omit to fall back to demo/guest auth) ──
GOOGLE_CLIENT_ID=
ALLOW_DEMO=1                # allow demo/guest sign-in even when GOOGLE_CLIENT_ID is set

# ── Buyer SMS (optional — omit for log-only mode, safe for local dev) ──
SMS_PROVIDER=               # afromessage | twilio
AFROMESSAGE_TOKEN=
AFROMESSAGE_FROM=
AFROMESSAGE_SENDER=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ── New-order alerts to a Telegram chat (optional) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Chapa hosted checkout (optional — card/mobile money/bank via Chapa) ──
# Get a secret key from https://dashboard.chapa.co after verifying your business.
# Without this, "Pay with Chapa" tells the buyer it isn't set up yet and falls
# back to manual bank transfer — it never fakes a successful payment.
CHAPA_SECRET_KEY=

# ── USSD push (optional — buyer approves payment via a USSD prompt) ──
# There is no universal public API for this; it requires a signed agreement
# with a specific bank or payment aggregator that offers push-USSD. Set these
# once you have one — until then, requests are logged (see /admin.html → SMS-
# like USSD log) and buyers are told to use bank transfer or Chapa instead.
USSD_PROVIDER=
USSD_API_URL=
USSD_API_KEY=
