# ── Ambassador store environment ──
PORT=3000
# Postgres connection string (Render injects this via render.yaml). Leave unset locally to use a JSON file store.
DATABASE_URL=
# Secret for session cookies (Render auto-generates). Any long random string.
JWT_SECRET=change-me-to-a-long-random-string
# Google OAuth Web client ID (https://console.cloud.google.com/apis/credentials).
# Authorized JavaScript origins: your Render URL (and http://localhost:3000 for dev).
GOOGLE_CLIENT_ID=
# Key for /admin dashboard + admin API (Render auto-generates).
ADMIN_KEY=change-me
# Optional: per-order Telegram notifications to the marketplace operator.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set ALLOW_DEMO=1 to keep demo sign-in available even with Google configured.
ALLOW_DEMO=
